{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaygraph.local/schema/sidecar.schema.json",
  "title": "RelayGraph Sidecar",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "metadata": {
      "type": "object"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "to"],
        "properties": {
          "rel": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "to": {
            "type": "string",
            "pattern": "^(id:.*\\S.*|path:(?!.?:)(?![\\\\/])(?!.*[\\\\/]\\.\\.([\\\\/]|$))(?!\\.\\.([\\\\/]|$)).*\\S.*)$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "pathHint": {
            "type": "string",
            "pattern": "^(?!.?:)(?![\\\\/])(?!.*[\\\\/]\\.\\.([\\\\/]|$))(?!\\.\\.([\\\\/]|$)).*\\S.*$"
          },
          "order": {
            "type": "integer"
          },
          "acknowledged": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceRevision", "targetRevision"],
            "properties": {
              "sourceRevision": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "targetRevision": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "linkRevision": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["links"],
        "properties": {
          "links": {
            "contains": {
              "required": ["acknowledged"]
            }
          }
        }
      },
      "then": {
        "required": ["schemaVersion"],
        "properties": {
          "schemaVersion": {
            "enum": [2, 3]
          }
        }
      }
    },
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "links": {
            "items": {
              "properties": {
                "acknowledged": {
                  "not": {
                    "required": ["linkRevision"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "links": {
            "items": {
              "if": {
                "required": ["acknowledged"]
              },
              "then": {
                "properties": {
                  "acknowledged": {
                    "required": ["linkRevision"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["links"],
        "properties": {
          "links": {
            "contains": {
              "required": ["reason"]
            }
          }
        }
      },
      "then": {
        "required": ["schemaVersion"],
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      }
    }
  ]
}
